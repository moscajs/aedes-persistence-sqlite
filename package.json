{
  "name": "aedes-persistence-sqlite",
  "version": "1.0.0",
  "description": "SQLite persistence for Aedes using the Node.js built-in SQLite module",
  "main": "persistence.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "unit": "node --test --test-timeout=180000 test/test.js",
    "test": "npm run lint && npm run unit",
    "coverage": "c8 --reporter=lcov npm run unit",
    "coverage:report": "c8 report",
    "release": "read -p 'GITHUB_TOKEN: ' GITHUB_TOKEN && export GITHUB_TOKEN=$GITHUB_TOKEN && release-it --disable-metrics"
  },
  "precommit": "test",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seriousme/aedes-persistence-sqlite.git"
  },
  "keywords": [
    "aedes",
    "mqtt",
    "broker",
    "sqlite",
    "sqlite3"
  ],
  "author": "Hans Klunder",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seriousme/aedes-persistence-sqlite/issues"
  },
  "homepage": "https://github.com/seriousme/aedes-persistence-sqlite#readme",
  "devDependencies": {
    "@fastify/pre-commit": "^2.2.0",
    "aedes": "^0.51.3",
    "c8": "^10.1.3",
    "eslint": "^9.30.1",
    "neostandard": "^0.12.2",
    "release-it": "^19.0.3"
  },
  "dependencies": {
    "aedes-packet": "^3.0.0",
    "aedes-persistence": "^10.2.2",
    "msgpack-lite": "^0.1.26",
    "qlobber": "^8.0.1"
  }
}
